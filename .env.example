# paper: 只模拟下单；testnet: 币安测试网；live: 币安实盘
BTRADER_TRADING_MODE=paper

# 实盘必须同时改成 true，防止误切实盘。
BTRADER_LIVE_TRADING_ENABLED=false

# Telegram 白名单。多个 ID 用英文逗号分隔；建议同时限制 user 和 chat。
BTRADER_ALLOWED_USER_IDS=123456789
BTRADER_ALLOWED_CHAT_IDS=123456789

# keyring 使用 macOS 钥匙串；env 仅适合临时开发。
BTRADER_SECRET_BACKEND=keyring
BTRADER_KEYRING_SERVICE=btrader

# 风控硬上限（均可改）。
BTRADER_MAX_RISK_USDT=500
BTRADER_MAX_NOTIONAL_USDT=10000
BTRADER_MAX_LEVERAGE=20
BTRADER_DEFAULT_RR=1.5
BTRADER_DEFAULT_TAKE_PROFIT_PERCENT=75
BTRADER_DEFAULT_PROTECT_BREAKEVEN=true
BTRADER_CONFIRM_TTL_SECONDS=120
BTRADER_MONITOR_INTERVAL_SECONDS=2
BTRADER_STOP_LIMIT_BUFFER_BPS=10
BTRADER_FEE_BUFFER_BPS=0
BTRADER_DATA_DIR=data
BTRADER_LOG_LEVEL=INFO

# 只有 BTRADER_SECRET_BACKEND=env 时才读取以下值。不要提交真实值。
# BTRADER_TELEGRAM_BOT_TOKEN=
# BTRADER_BINANCE_API_KEY=
# BTRADER_BINANCE_API_SECRET=
# 测试网通常需要分别配置现货和合约凭据；keyring 也支持以下密钥名。
# BTRADER_BINANCE_SPOT_API_KEY=
# BTRADER_BINANCE_SPOT_API_SECRET=
# BTRADER_BINANCE_FUTURES_API_KEY=
# BTRADER_BINANCE_FUTURES_API_SECRET=
# BTRADER_TOTP_SECRET=
